<Page x:Class="Dnkhw.Pages.DiskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Loaded="OnLoaded">
    <Page.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <ui:DynamicScrollViewer>
        <StackPanel MaxWidth="980" HorizontalAlignment="Center" Margin="32,28,32,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="磁盘分析" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="选择磁盘自动扫描占用排行；切换磁盘即时重扫，垃圾位置只展示不删除" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="重新扫描" Command="{Binding ScanCommand}"
                               IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                    <ui:Button Content="取消" Appearance="Secondary" Margin="10,0,0,0" Command="{Binding CancelScanCommand}"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" Margin="12,0,0,0"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True"/>
                <TextBlock Text="{Binding ProgressText}" Foreground="#1967D2" FontWeight="SemiBold" FontSize="13"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <ui:InfoBar Margin="0,10,0,0" IsOpen="{Binding NoticeOpen, Mode=TwoWay}"
                        Title="{Binding NoticeText}" Severity="Informational" IsClosable="True"/>

            <ui:Card Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="选择磁盘（点击即扫描）" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="16,10" Margin="0,0,10,8" MinWidth="220"
                                        Background="#F3F5F9" BorderBrush="#E0E4EB" BorderThickness="1"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Root}" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Label}" Margin="8,0,0,0" FontSize="13" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding TotalText}" Opacity="0.55" FontSize="12"/>
                                            <TextBlock Text="｜" Opacity="0.3" FontSize="12" Margin="6,0"/>
                                            <TextBlock Text="{Binding FreeText}" Foreground="#1967D2" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="16" Visibility="{Binding TopFolders, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4">
                        <Run Text="目录占用排行 · "/><Run Text="{Binding ScannedRoot}" Foreground="#1967D2"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SummaryText}" Opacity="0.6" FontSize="12" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding TopFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                        <ui:Button Appearance="Transparent" Content="定位" FontSize="11" Padding="8,2" Margin="6,0,0,0"
                                                   Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding Path}"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Height="6" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}" Margin="8,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Percent, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" Width="38"/>
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.55" FontSize="12"
                                               Text="{Binding FileCount, StringFormat={}{0:N0} 个文件}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="16" Visibility="{Binding TopFiles, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8">
                        <Run Text="最大文件 Top 30 · "/><Run Text="{Binding ScannedRoot}" Foreground="#1967D2"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding TopFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                        <TextBlock Text="{Binding Path}" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <ui:Button Grid.Column="2" Appearance="Transparent" Content="定位" FontSize="11" Padding="8,2" Margin="10,0,0,0"
                                               Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Path}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="16" Visibility="{Binding JunkLocations, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="常见可清理位置（仅展示，本工具不自动删除）" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding JunkLocations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <ui:Button Grid.Column="2" Appearance="Transparent" Content="打开" FontSize="11" Padding="8,2" Margin="10,0,0,0"
                                               Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding Path}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
