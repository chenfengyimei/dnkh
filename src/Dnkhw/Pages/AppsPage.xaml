<Page x:Class="Dnkhw.Pages.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Loaded="OnLoaded">
    <Page.Resources>
        <Style x:Key="StatusTextBlock" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Installed">
                    <Setter Property="Foreground" Value="#0F7B0F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Succeeded">
                    <Setter Property="Foreground" Value="#0F7B0F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Foreground" Value="#C5221F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Installing">
                    <Setter Property="Foreground" Value="#1967D2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ui:DynamicScrollViewer>
        <StackPanel MaxWidth="980" HorizontalAlignment="Center" Margin="32,28,32,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="APP 推荐" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="精选常用软件：官方渠道、无捆绑安装器、无弹窗广告，通过 winget 静默安装" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InstallSummary}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7"/>
                    <ui:Button Content="重新检测" Appearance="Secondary" Command="{Binding LoadCommand}"/>
                    <ui:Button Content="安装选中" Margin="10,0,0,0" Command="{Binding InstallSelectedCommand}"/>
                    <ui:Button Content="安装 App Installer" Appearance="Secondary" Margin="10,0,0,0"
                               Command="{Binding InstallAppInstallerCommand}"
                               Visibility="{Binding WingetAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" Margin="12,0,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <ui:Card Margin="0,14,0,0" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="安装根目录" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ui:TextBox Grid.Column="1" Text="{Binding InstallRoot}" IsReadOnly="True"
                                    PlaceholderText="安装前请先选择目录，例如 D:\Apps"/>
                        <ui:Button Grid.Column="2" Content="选择目录" Appearance="Secondary" Margin="10,0,0,0"
                                   Click="BrowseInstallRoot_Click"/>
                    </Grid>
                    <CheckBox Content="显示每个软件的安装界面，可再次确认组件和位置（推荐）"
                              IsChecked="{Binding InteractiveInstall}" Margin="0,12,0,0"/>
                    <TextBlock Margin="0,8,0,0" Opacity="0.68" FontSize="12" TextWrapping="Wrap"
                               Text="每个应用会使用所选目录下的独立子目录。WinGet 仅能为支持自定义位置的软件指定目录；个别安装器可能拒绝或忽略该位置，请在弹出的安装界面再次确认，必要时改用官网安装。下载过程仍可能短暂使用系统临时目录，安装完成后由安装器清理。"/>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Margin="0,14,0,0" IsOpen="{Binding NoticeOpen, Mode=TwoWay}"
                        Title="{Binding NoticeText}" Severity="Informational" IsClosable="True"/>

            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                                          IsEnabled="{Binding CanInstall}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <Border Background="#E8F0FE" CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding Recommend, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="推荐" FontSize="10" Foreground="#1967D2"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="12" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding StatusDetail}" Foreground="#C5221F" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding StatusDetail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource StatusTextBlock}"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <ui:Button Content="安装" Appearance="Primary"
                                                               Command="{Binding DataContext.InstallOneCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}"
                                                               Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <ui:Button Content="重试" Appearance="Primary" Margin="6,0,0,0"
                                                               Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}"
                                                               Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <ui:Button Content="官网" Appearance="Secondary" Margin="6,0,0,0"
                                                               Command="{Binding DataContext.OpenHomeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
