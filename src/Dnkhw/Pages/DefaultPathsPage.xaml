<Page x:Class="Dnkhw.Pages.DefaultPathsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Loaded="OnLoaded">
    <Page.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- 选中/焦点视觉交给 chip 自身样式，去掉默认的矩形选中框 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ui:DynamicScrollViewer>
        <StackPanel MaxWidth="980" HorizontalAlignment="Center" Margin="32,28,32,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="默认路径换盘" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="桌面 / 文档 / 下载 / 图片 / 音乐 / 视频 六个默认文件夹一键换盘迁移；浏览器与资源管理器自动跟随" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="刷新状态" Command="{Binding LoadCommand}"/>
                    <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" Margin="12,0,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <ui:InfoBar Margin="0,14,0,0" IsOpen="{Binding NoticeOpen, Mode=TwoWay}"
                        Title="{Binding NoticeText}" Severity="Informational" IsClosable="True"/>

            <ui:Card Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="选择文件夹" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ChipBorder" CornerRadius="8" Padding="16,10" Margin="0,0,10,8" MinWidth="200"
                                        Background="#F3F5F9" BorderBrush="#E0E4EB" BorderThickness="1"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ChipName" Text="{Binding Name}" FontSize="17" FontWeight="Bold"/>
                                            <Border Background="#E8F0FE" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsRedirected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="已重定向" FontSize="10" Foreground="#1967D2"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="ChipPath" Text="{Binding CurrentPath}" Opacity="0.55" FontSize="11" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="ChipBorder" Property="Background" Value="#1967D2"/>
                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#1967D2"/>
                                        <Setter TargetName="ChipName" Property="Foreground" Value="White"/>
                                        <Setter TargetName="ChipPath" Property="Foreground" Value="#CFE3F8"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True"/>
                <TextBlock Text="正在读取文件夹内容统计…（文件较多时可能需要数十秒）" Margin="10,0,0,0"
                           Foreground="#1967D2" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>

            <ui:Card Margin="0,12,0,0" Padding="18">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10">
                        <Run Text="当前状态 · "/><Run Text="{Binding SelectedFolder.Name, Mode=OneWay}" Foreground="#1967D2"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="文件夹位置："/><Run Text="{Binding CurrentPath}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" Opacity="0.7" Text="{Binding RedirectStatusText}"/>
                    <TextBlock Margin="0,4,0,0" Opacity="0.7" Text="{Binding SourceFileSummary}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="选择目标盘" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock Text="将创建 〈盘〉:\〈文件夹名〉 并把默认位置指向它" Opacity="0.6" FontSize="12" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding Drives}" DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedDrive}" MinWidth="340" HorizontalAlignment="Left"/>

                    <ui:ToggleSwitch Margin="0,14,0,0" IsChecked="{Binding MoveFiles}"
                                     Content="迁移现有文件（推荐；被占用的文件会跳过并列出清单）"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Content="开始迁移" Command="{Binding MigrateCommand}"/>
                        <ui:Button Content="取消迁移" Appearance="Secondary" Margin="10,0,0,0" Command="{Binding CancelMigrateCommand}"
                                   Visibility="{Binding IsMigrating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:Button Content="还原默认位置" Appearance="Secondary" Margin="10,0,0,0" Command="{Binding RestoreCommand}"
                                   Visibility="{Binding IsRedirected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <ProgressBar Margin="0,16,0,4" Minimum="0" Maximum="{Binding ProgressTotal, FallbackValue=1}"
                                 Value="{Binding ProgressCompleted, Mode=OneWay}"
                                 Visibility="{Binding ProgressTotal, Converter={StaticResource ZeroToCollapsedConverter}}"/>
                    <TextBlock Text="{Binding ProgressFile}" Opacity="0.55" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="18"
                     Visibility="{Binding IsDownloadsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="浏览器下载设置（仅下载文件夹）" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="跟随系统设置的浏览器迁移后自动生效；已自定义目录的需手动修改" Opacity="0.6" FontSize="12" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Browsers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ui:Button Grid.Column="2" Content="打开设置" Appearance="Secondary" VerticalAlignment="Center"
                                               Command="{Binding DataContext.OpenBrowserSettingsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ItemsControl ItemsSource="{Binding LastFailures}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
