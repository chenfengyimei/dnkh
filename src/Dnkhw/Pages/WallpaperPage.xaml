<Page x:Class="Dnkhw.Pages.WallpaperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Loaded="OnLoaded">
    <ui:DynamicScrollViewer>
        <StackPanel MaxWidth="980" HorizontalAlignment="Center" Margin="32,28,32,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="壁纸开荒" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Bing 中国区每日壁纸（近一周），一键下载并设为桌面" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="刷新列表" Command="{Binding LoadCommand}"/>
                    <TextBlock Text="填充模式" VerticalAlignment="Center" Margin="12,0,6,0" Opacity="0.7"/>
                    <ComboBox Width="110" ItemsSource="{Binding FitOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedFit}"/>
                    <ui:Button Content="本地图片" Appearance="Secondary" Margin="12,0,0,0" Command="{Binding SetLocalCommand}"/>
                    <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" Margin="12,0,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <ui:InfoBar Margin="0,14,0,0" IsOpen="{Binding NoticeOpen, Mode=TwoWay}"
                        Title="{Binding NoticeText}" Severity="Informational" IsClosable="True"/>

            <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Width="300" Margin="0,0,12,12" Padding="8">
                            <StackPanel>
                                <Image Source="{Binding ThumbPath, Converter={StaticResource ImagePathConverter}}"
                                       Width="284" Height="170" Stretch="UniformToFill"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DateText}" Opacity="0.55" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="设为壁纸" Appearance="Secondary"
                                               VerticalAlignment="Center"
                                               Command="{Binding DataContext.SetWallpaperCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
