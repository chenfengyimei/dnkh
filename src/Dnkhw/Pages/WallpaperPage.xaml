<Page x:Class="Dnkhw.Pages.WallpaperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Loaded="OnLoaded">
    <ui:DynamicScrollViewer>
        <StackPanel MaxWidth="980" HorizontalAlignment="Center" Margin="32,28,32,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="壁纸开荒" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="五步桌面美化：隐藏图标 → 任务栏自动隐藏 → 透明化 → Dock 栏 → 设置壁纸" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ui:ProgressRing Grid.Column="1" Width="22" Height="22" IsIndeterminate="True" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>

            <ui:InfoBar Margin="0,14,0,0" IsOpen="{Binding NoticeOpen, Mode=TwoWay}"
                        Title="{Binding NoticeText}" Severity="Informational" IsClosable="True"/>

            <ui:Card Margin="0,16,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="步骤 1 · 隐藏桌面图标" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="纯享桌面更清爽；桌面右键「查看 → 显示桌面图标」可随时恢复" Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                     IsChecked="{Binding DesktopIconsHidden, Mode=TwoWay}"
                                     Click="OnIconsToggleClick"/>
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="步骤 2 · 任务栏自动隐藏" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="鼠标移到屏幕底部才显示任务栏，最大化欣赏壁纸；随时可关" Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                     IsChecked="{Binding TaskbarAutoHide, Mode=TwoWay}"
                                     Click="OnTaskbarToggleClick"/>
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="步骤 3 · 任务栏透明化（TranslucentTB）" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="开源小工具（微软商店同款），让任务栏融入壁纸" Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="一键安装" VerticalAlignment="Center"
                                   Command="{Binding InstallTranslucentCommand}"
                                   Visibility="{Binding TranslucentInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <Border Grid.Column="1" Background="#DFF0E8" CornerRadius="3" Padding="10,4"
                                VerticalAlignment="Center"
                                Visibility="{Binding TranslucentInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="已安装" FontSize="12" Foreground="#0F7B0F"/>
                        </Border>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,10,0,0" LineHeight="20"
                               Text="配置方法：安装后系统托盘（右下角箭头里）会出现 TranslucentTB 图标 → 右键 → Open TranslucentTB → 「Taskbar」样式选 Clear 即全透明，也可选 Blur / Acrylic 毛玻璃效果。开机自启在软件内 Taskbar → Open at boot 勾选。"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="步骤 4 · Dock 栏（可选）" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="macOS 风格启动栏，配合步骤 1 / 2 隐藏图标与任务栏，桌面效果最佳。二选一即可，安装后把常用软件拖入 Dock。" Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="RocketDock（免费经典）" Command="{Binding OpenRocketDockSiteCommand}"/>
                        <ui:Button Content="商店搜 MyDockFinder" Appearance="Secondary" Margin="10,0,0,0" Command="{Binding OpenStoreDockSearchCommand}"/>
                    </StackPanel>
                    <TextBlock Text="RocketDock 使用：安装后把快捷方式拖到 Dock 上即可；在 Dock 设置里可调图标大小、动画与自动隐藏（勾选 Auto-hide 与步骤 2 的任务栏隐藏配套）。" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,10,0,0" LineHeight="20"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="步骤 5 · 设置壁纸" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="前四步就绪后，二选一收尾：想要省心静态壁纸选本地图片或 Bing 精选；想要动态桌面用 Steam 壁纸引擎" Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="选择一 · 静态壁纸（本地图片 / Bing 精选）" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                        <ui:Button Content="刷新列表" Command="{Binding LoadCommand}"/>
                        <TextBlock Text="填充模式" VerticalAlignment="Center" Margin="12,0,6,0" Opacity="0.7"/>
                        <ComboBox Width="110" ItemsSource="{Binding FitOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedFit}"/>
                        <ui:Button Content="本地图片" Appearance="Secondary" Margin="12,0,0,0" Command="{Binding SetLocalCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Width="300" Margin="0,0,12,12" Padding="8">
                                    <StackPanel>
                                        <Image Source="{Binding ThumbPath, Converter={StaticResource ImagePathConverter}}"
                                               Width="284" Height="170" Stretch="UniformToFill"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DateText}" Opacity="0.55" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="设为壁纸" Appearance="Secondary"
                                                       VerticalAlignment="Center"
                                                       Command="{Binding DataContext.SetWallpaperCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,16,0,12"/>

                    <TextBlock Text="选择二 · 动态壁纸（Steam 壁纸引擎 Wallpaper Engine）" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,4,0,0" LineHeight="20"
                               Text="Steam 上最热门的动态壁纸软件（付费，国区约 ¥19 一次买断）：视频、场景、交互式壁纸应有尽有，创意工坊海量壁纸免费订阅，配合前四步的纯享桌面效果最佳。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="打开 Steam 商店页" Command="{Binding OpenWallpaperEngineStoreCommand}"/>
                        <ui:Button Content="一键安装 Steam" Appearance="Secondary" Margin="10,0,0,0"
                                   Command="{Binding InstallSteamCommand}"
                                   Visibility="{Binding SteamInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <Border Background="#DFF0E8" CornerRadius="3" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0"
                                Visibility="{Binding SteamInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Steam 已安装" FontSize="12" Foreground="#0F7B0F"/>
                        </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,10,0,0" LineHeight="20"
                               Text="使用方法：在商店页购买并安装壁纸引擎 → 打开后从「已安装」标签挑选壁纸，或到创意工坊订阅喜欢的动态壁纸（自动下载并应用）→ 建议在软件设置中开启开机自启，开机即享动态桌面。"/>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
