<ui:FluentWindow x:Class="Dnkhw.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Dnkhw.Pages"
                 Title="电脑开荒"
                 Width="1200" Height="800"
                 MinWidth="980" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="电脑开荒" CanMaximize="True"/>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           Loaded="RootNavigation_Loaded">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="开荒检查" Icon="{ui:SymbolIcon DocumentBulletList24}" TargetPageType="{x:Type pages:CheckPage}" />
                <ui:NavigationViewItem Content="壁纸开荒" Icon="{ui:SymbolIcon Image24}" TargetPageType="{x:Type pages:WallpaperPage}" />
                <ui:NavigationViewItem Content="默认路径换盘" Icon="{ui:SymbolIcon FolderSwap24}" TargetPageType="{x:Type pages:DefaultPathsPage}" />
                <ui:NavigationViewItem Content="APP 推荐" Icon="{ui:SymbolIcon AppsList24}" TargetPageType="{x:Type pages:AppsPage}" />
                <ui:NavigationViewItem Content="启动项管理" Icon="{ui:SymbolIcon Rocket24}" TargetPageType="{x:Type pages:StartupPage}" />
                <ui:NavigationViewItem Content="Windows 优化" Icon="{ui:SymbolIcon Wrench24}" TargetPageType="{x:Type pages:OptimizePage}" />
                <ui:NavigationViewItem Content="磁盘分析" Icon="{ui:SymbolIcon DataUsage24}" TargetPageType="{x:Type pages:DiskPage}" />
                <ui:NavigationViewItem Content="电脑开荒网" Icon="{ui:SymbolIcon Globe24}" TargetPageType="{x:Type pages:WebsitePage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="AdminBadge" Content="权限：检测中…" Icon="{ui:SymbolIcon Shield24}" IsEnabled="False" />
                <ui:NavigationViewItem Content="设置" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
                <ui:NavigationViewItem Content="关于" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
